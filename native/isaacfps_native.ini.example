# IsaacFPS native layer configuration.
# Copy to isaacfps_native.ini next to isaacfps_native.dll.

# Master switch. 0 = the DLL attaches and does nothing.
enabled=1

# Shadow skipping mode:
#   adaptive - skip entity shadows only while frame time says the game is
#              lagging; restore them automatically when headroom returns.
#              (default, recommended)
#   always   - entity shadows are always skipped (maximum FPS)
#   never    - hook stays installed but never skips (measurement only)
shadows=adaptive

# Adaptive thresholds (frames per second).
# Lagging  = smoothed frame time stays above 1000/target_fps
# Headroom = smoothed frame time stays below 1000/recover_fps
target_fps=55
recover_fps=70

# Also skip ground-impact cosmetic FX while shedding (0 disables that hook).
ground_impacts=1

# Visual self-test: force-shed for this many seconds right after injecting.
# Entity shadows should visibly disappear. If they don't, your game build
# doesn't match the signatures. If they do but FPS is unchanged, cosmetic
# shedding is not your bottleneck. 0 disables.
force_test=15

# Seconds between periodic status log lines (frame time, time spent inside
# the measured phase, shedding state, skip counters). 0 disables.
status_interval=5

# What to do when NO frame measurement is available at all: always | never.
# (With REPENTOGON present, IsaacFPS measures via Level::Update instead, so
# adaptive normally still works; this is only the last-resort fallback.)
adaptive_fallback=never

# Write isaacfps_native.log next to the DLL.
log=1
